# Optional: Plausible Analytics (adblock-resistant, cookieless, no banner)
# Sign up at https://plausible.io (or self-host) and set your domain:
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=eyecare.love
# Optional: override script URL if self-hosted or using a custom subdomain proxy
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.outbound-links.js

# Optional: Microsoft Clarity (free heatmap + session replay, cookieless)
# Sign up at https://clarity.microsoft.com → New Project → copy the Project ID
# NEXT_PUBLIC_CLARITY_PROJECT=xxxxxxxxxx
